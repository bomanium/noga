<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop app (docs/decisions/2026-11-01-desktop-app.md): an Avalonia window to drop files on, checking them
       with the command line's Checker and showing each one's verdict and reports. No console window on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>noga-app</AssemblyName>
    <RootNamespace>Noga.App</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The Windows executable's icon (Explorer, the taskbar before the window opens). Built into the .exe on every
         platform, so the .ico is committed (tools/make-icons.sh generates it from Assets/icon.svg). -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window's icon (MainWindow.AppIcon), embedded. -->
    <EmbeddedResource Include="Assets\icon-256.png" LogicalName="Noga.App.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noga.Checking\Noga.Checking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noga.AppTests" />
  </ItemGroup>

  <!--
    A publish for one platform (tools/publish.sh, into the command line's folder) ships the renderers' notices beside
    them: SkiaSharp's (Skia, HarfBuzz, FreeType, ANGLE, libpng and the rest compiled into libSkiaSharp and
    libHarfBuzzSharp) to licences/skiasharp/, and ANGLE's licence (libEGL and libGLESv2 on Windows) to licences/angle/.
  -->
  <Target Name="PublishLicences" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <SkiaNoticeFile Include="$(NuGetPackageRoot)skiasharp.nativeassets.linux/*/THIRD-PARTY-NOTICES.txt" />
      <AngleLicence Include="$(NuGetPackageRoot)avalonia.angle.windows.natives/*/LICENSE" />
      <ResolvedFileToPublish Include="@(SkiaNoticeFile)" RelativePath="licences/skiasharp/THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(AngleLicence)" RelativePath="licences/angle/LICENSE" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <!-- On Linux, the desktop entry: the icon, a .desktop file that runs noga-app from the folder it is in, and
         install-desktop-entry.sh, which puts both into the desktop's menu (packaging/README.txt). -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)Assets/icon-256.png" RelativePath="noga-app.png" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)../../packaging/linux/noga-app.desktop" RelativePath="noga-app.desktop" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(MSBuildThisFileDirectory)../../packaging/linux/install-desktop-entry.sh" RelativePath="install-desktop-entry.sh" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(SkiaNoticeFile)' == ''" Text="No SkiaSharp THIRD-PARTY-NOTICES.txt: the app ships its renderers' notices." />
  </Target>

</Project>
