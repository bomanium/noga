<Project Sdk="Microsoft.NET.Sdk">

  <!-- The FFmpeg decoding path (docs/decisions/2026-10-31-decoding.md): FrameReader over FFmpeg's LGPL libraries,
       which FrameReader.Native ships as separate shared libraries with their licence beside them (docs/dependencies.md). -->
  <PropertyGroup>
    <RootNamespace>Noga.Ffmpeg</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FrameReader" />
    <!-- The shot list (Shots). -->
    <PackageReference Include="ShotDetector" />
    <!-- The release platforms (tools/publish.sh): CI's, the owner's, and Linux on ARM (decisions/2026-11-03-linux-arm64.md). -->
    <PackageReference Include="FrameReader.Native.linux-x64" />
    <PackageReference Include="FrameReader.Native.linux-arm64" />
    <PackageReference Include="FrameReader.Native.win-x64" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Noga.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noga.Core\Noga.Core.csproj" />
  </ItemGroup>

</Project>
