<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Authors>Jakob Boman</Authors>
    <Copyright>Copyright (c) Jakob Boman</Copyright>
    <Version>0.1.0-alpha.1</Version>
    <!-- A private, commercial product: nothing here is published to NuGet (CLAUDE.md, hard rules). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StyleBro.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
