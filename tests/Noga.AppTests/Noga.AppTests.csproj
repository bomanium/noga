<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop app on Avalonia's headless platform: no display needed, so CI runs them on ubuntu. -->
  <PropertyGroup>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3.x needs a newer Microsoft.Testing.Platform than xunit.v3 3.2 brings; 2.x is VSTest only. -->
    <PackageReference Include="GitHubActionsTestLogger" VersionOverride="2.4.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Noga.App\Noga.App.csproj" />
  </ItemGroup>

</Project>
