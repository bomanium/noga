<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The weekly film tests (.github/workflows/films.yml; docs/decisions/2026-11-01-open-films.md): each figure on
    Blender's open films, which tools/get-films.sh downloads, against the ffmpeg command line. They take ~30 min and
    ~650 MB of films, so they run only where NOGA_FILMS names the films' folder; elsewhere (dotnet test
    Noga.slnx, CI's build) no.runsettings filters every test out.
  -->
  <PropertyGroup>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <RunSettingsFilePath Condition="'$(NOGA_FILMS)' == ''">$(MSBuildThisFileDirectory)no.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The same comparisons with the ffmpeg command line as the sample tests'. -->
    <Compile Include="..\Noga.Tests\FfmpegCli.cs" Link="FfmpegCli.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Noga.Core\Noga.Core.csproj" />
    <ProjectReference Include="..\..\src\Noga.Ffmpeg\Noga.Ffmpeg.csproj" />
  </ItemGroup>

</Project>
