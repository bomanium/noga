<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Every package and its licence: docs/dependencies.md (usable anywhere, closed-source commercial use included; no GPL/AGPL). -->
  <ItemGroup>
    <!-- Moves with the format tool in .config/dotnet-tools.json, in one PR. -->
    <PackageVersion Include="StyleBro.Analyzers" Version="0.8.0-alpha.1" />
    <!-- FFmpeg through FrameReader (MIT) and FFmpeg's shared libraries (LGPL, separate and replaceable). They move together. -->
    <PackageVersion Include="FrameReader" Version="2.25.0" />
    <PackageVersion Include="FrameReader.Native.linux-x64" Version="2.25.0" />
    <PackageVersion Include="FrameReader.Native.linux-arm64" Version="2.26.0" />
    <PackageVersion Include="FrameReader.Native.win-x64" Version="2.25.0" />
    <!-- The shot list: PySceneDetect's detectors (MIT), at FrameReader's version; FastYuv (LGPL-2.1-or-later) converts
         the managed path's frames, a separate, replaceable assembly with its licence beside it. They move together. -->
    <PackageVersion Include="ShotDetector" Version="3.30.0" />
    <PackageVersion Include="ShotDetector.FastYuv" Version="3.30.0" />
    <!-- The desktop app (Noga.App): Avalonia (MIT), its Skia and HarfBuzz renderers (MIT) come with it. They move together. -->
    <PackageVersion Include="Avalonia" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <!-- Pure managed H.264/AAC decoding and MP4 demuxing (MIT). -->
    <PackageVersion Include="ManagedCodecs" Version="0.4.0" />
    <!-- Tests only. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <!-- The desktop app's tests: Avalonia.Headless.XUnit needs xunit v3, at the version it builds on. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Each failed test as a check-run annotation in CI. -->
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
  </ItemGroup>
</Project>
